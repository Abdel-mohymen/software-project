# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Shared Team MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giu_travel_platform?retryWrites=true&w=majority

# Authentication & JWT Cookies (ACC-06, ACC-19)
JWT_ACCESS_SECRET=replace_with_strong_access_secret_key
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Default Seeded Administrator Credentials (ACC-18)
ADMIN_SEED_EMAIL=admin@giu-travel.com
ADMIN_SEED_PASSWORD=Admin1234
ADMIN_SEED_NAME=Platform Administrator

# Platform Base Currency (PAY-04)
PLATFORM_CURRENCY=USD

# Stripe Test Mode Credentials (PAY-01, PAY-03)
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret

# FXRatesAPI Configuration (ITN-18)
FXRATES_API_URL=https://api.fxratesapi.com/latest
FXRATES_API_KEY=

# Optional SMTP Configuration for Bonus Features (ACC-02, ACC-07, GEN-01-B)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@giu-travel.com

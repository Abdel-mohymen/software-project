# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Shared Team MongoDB Atlas Connection String (Required)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giu_travel_platform?retryWrites=true&w=majority

# Authentication & JWT Cookies (ACC-06, ACC-19)
JWT_ACCESS_SECRET=giu_sp1_w26_jwt_access_secret_key_change_in_prod
JWT_REFRESH_SECRET=giu_sp1_w26_jwt_refresh_secret_key_change_in_prod
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Default Seeded Administrator Credentials (ACC-18)
ADMIN_SEED_EMAIL=admin@giu-travel.com
ADMIN_SEED_PASSWORD=Admin1234
ADMIN_SEED_NAME=Platform Administrator

# Platform Base Currency (PAY-04)
PLATFORM_CURRENCY=USD

# Stripe Test Mode Credentials (PAY-01, PAY-03) — Non-empty secret required at startup
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_giu_sp1_w26_local_dev_webhook_signing_key

# FXRatesAPI Configuration (ITN-18)
FXRATES_API_URL=https://api.fxratesapi.com/latest
FXRATES_API_KEY=
